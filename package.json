{
  "name": "embedded-studio",
  "productName": "Embedded Studio",
  "version": "0.1.0",
  "description": "Cross-platform embedded debug studio: registers, live plots and stepping over DAPLink / ST-Link with a Rust probe core.",
  "private": true,
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --mock",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "dist": "npm run build:native && electron-builder --publish never",
    "install:windows": "node scripts/install-windows.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "web": "node server/serve.cjs"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.embedded-studio.app",
    "productName": "Embedded Studio",
    "files": [
      "electron/**",
      "renderer/**",
      "assets/icon.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "assets/70-embedded-studio-probes.rules",
        "to": "70-embedded-studio-probes.rules"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "bin/win32-${arch}",
          "to": "bin/win32-${arch}"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "bin/darwin-${arch}",
          "to": "bin/darwin-${arch}"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "bin/linux-${arch}",
          "to": "bin/linux-${arch}"
        }
      ]
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
